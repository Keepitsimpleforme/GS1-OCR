# ── Copy this file to .env and fill in values ─────────────────────────────
# The .env file is loaded by the systemd service (EnvironmentFile=) and is
# git-ignored so secrets never enter the repository.
#
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Ollama model used for OCR
# Must be pulled first:  ollama pull maternion/LightOnOCR-2
OLLAMA_MODEL=maternion/LightOnOCR-2

# How long (seconds) to wait for a single OCR response before returning 504
OLLAMA_TIMEOUT_SECONDS=45

# How long (seconds) to wait for the Ollama health check
OLLAMA_HEALTH_TIMEOUT_SECONDS=5

# How long (seconds) to attempt barcode decoding before giving up
BARCODE_TIMEOUT_SECONDS=5

# Maximum image upload size in MB
MAX_UPLOAD_MB=20

# CORS allowed origins (comma-separated).
# On the VM, nginx serves both frontend and API on the same origin, so CORS is
# only needed for external direct-API callers.
# Use * to allow any origin, or list specific domains:
#   CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=*

# Custom OCR prompt (optional — leave blank to use the default)
# OCR_PROMPT=Transcribe the text in this image exactly as it appears.

# ── Copy this file to .env and fill in values ─────────────────────────────
# cp .env.example .env
# This file is git-ignored. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Ollama connection ──────────────────────────────────────────────────────
# When running Ollama on the same VM as the API, keep localhost:11434.
# When tunnelling from local dev to the VM: ssh -L 11434:localhost:11434 user@vm-ip
OLLAMA_HOST=localhost:11434

# ── Model names ────────────────────────────────────────────────────────────
# OCR model — reads raw text from the image
# Pull with: ollama pull maternion/LightOnOCR-2
OLLAMA_MODEL_OCR=maternion/LightOnOCR-2

# Extraction model — structured field extraction from OCR text
# Pull with: ollama pull qwen2.5:7b
# Needs ~5 GB RAM in Q4 quantisation
OLLAMA_MODEL_EXTRACT=qwen2.5:7b

# ── Timeouts ───────────────────────────────────────────────────────────────
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_HEALTH_TIMEOUT_SECONDS=5
BARCODE_TIMEOUT_SECONDS=5

# ── Upload limits ──────────────────────────────────────────────────────────
MAX_UPLOAD_MB=20

# ── CORS ───────────────────────────────────────────────────────────────────
# On VM, nginx serves frontend + API on same origin — CORS only matters for
# external direct-API callers.  Use * to allow any, or list specific domains.
CORS_ORIGINS=*

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

[Unit]
Description=GS1 OCR Backend (FastAPI + Uvicorn)
Documentation=https://github.com/YOUR_ORG/ocr-project
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/ocr-project/backend

# Load optional .env from project root
EnvironmentFile=-/opt/ocr-project/.env

ExecStart=/opt/ocr-project/backend/.venv/bin/python \
    -m uvicorn main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --log-level info

# Restart automatically if the process crashes
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

# Log to journald (view with: sudo journalctl -u ocr-backend -f)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ocr-backend

[Install]
WantedBy=multi-user.target
